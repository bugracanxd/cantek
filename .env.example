# ---- Database ----
# Local dev (SQLite) örneği:
# DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) örneği (Railway, Supabase, Neon, vb.):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cantek?schema=public"

# ---- Auth ----
# Rastgele uzun bir string üretin: `openssl rand -base64 32`
NEXTAUTH_SECRET="changeme-generate-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- PayTR ----
# https://www.paytr.com Mağaza Paneli > Mağaza Bilgilerim
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Test modunda ödeme her zaman başarılı sayılır - production'da mutlaka "0" yapın
PAYTR_TEST_MODE="1"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- İlk admin kullanıcı (sadece seed script için) ----
ADMIN_EMAIL="admin@cantek.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
